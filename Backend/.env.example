# Backend Environment Variables Template
# Copia este archivo a .env y actualiza los valores según tu entorno

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql+asyncpg://usuario:password@host/dbname?ssl=require

# JWT Configuration
SECRET_KEY=tu_super_secreto_aqui_para_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Base URL - Usado para construir URLs absolutas de archivos
# En desarrollo local: http://localhost:8000
# En producción en Render: https://incapacidades-backend.onrender.com
API_BASE_URL=http://localhost:8000
